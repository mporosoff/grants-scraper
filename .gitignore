# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Generated opportunity data
grants.json
grants_raw.json
faculty.json
faculty.csv
/data/*
!/data/opportunities.js
!/data/opportunity_enrichment.json
!/data/document_evidence.json
!/data/source_records.json
!/data/link_health.json
!/data/faculty_matches.js
# Added ahead of the cache itself: /data/* is deny-by-default, so a new cache
# file is invisible to git, and `git add` on an ignored path exits non-zero --
# which aborts the workflow's commit step and stops the nightly publishing
# entirely. See docs/TOPIC_LAYER_PLAN.md §0.4 rule 11 and §9.3.
!/data/subtopics.js
!/data/search-v2-voyage-manifest.json
!/data/search-v2-voyage-vectors.f16
!/data/search-v2-release.json
/GrantsDBExtract*.zip

# Human deployment-review files stay private and out of source control
/evaluation/inbox/
/evaluation/reports/
/docs/weekly-alerts/subscriptions.json

# Original local handoff archive
/files.zip

# Raw email samples used to tune the VPR/Cindy parser — private, never commit
*.eml

# Local application state
*.sqlite3
.env
.dev.vars*
.pnpm-store/

# Retired server experiment artifacts may remain in old local checkouts.
/web/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local agent/session settings (never commit)
.claude/
