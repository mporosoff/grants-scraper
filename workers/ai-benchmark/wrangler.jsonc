{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "funding-finder-ai-benchmark",
  "main": "src/index.js",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "BENCHMARK_RATE_LIMITER",
      "namespace_id": "6202608234",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
