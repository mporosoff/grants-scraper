{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "funding-finder-researchers",
  "account_id": "8cb81e39674e3ea3a2ff449371587dff",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "vars": {
    "PUBLIC_APP_ORIGIN": "https://mporosoff.github.io",
    "PUBLIC_SITE_ROOT": "https://mporosoff.github.io/grants-scraper",
    "REGISTRY_MANIFEST_URL": "https://mporosoff.github.io/grants-scraper/data/researcher_registry_manifest.json",
    "GITHUB_REPOSITORY": "mporosoff/grants-scraper",
    "REJECTED_RETENTION_DAYS": "90",
    "CONTACT_RETENTION_DAYS": "90"
  },
  "d1_databases": [
    {
      "binding": "SUBMISSIONS_DB",
      "database_name": "funding-finder-alerts",
      "database_id": "cae0a60b-b8d1-4cdf-96fe-092db8e2a51d",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "SUBMISSION_RATE_LIMITER",
      "namespace_id": "2001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "triggers": { "crons": ["17 7 * * *"] }
}
